# ── 비밀 ──────────────────────────────────────────────
# Gemini API 키가 들어 있습니다. 절대 커밋하지 마세요.
.env
*.env
!.env.example

# ── 교재 원본 ────────────────────────────────────────
# EBS 수능특강은 상업 교재입니다. 저장소에 올리지 않고
# 각자 받아서 01_원본자료/<과목>/ 에 두고 씁니다.
01_원본자료/**/*.pdf
01_원본자료/**/*.hwp
01_원본자료/**/*.hwpx

# ── manim 중간 산출물 ────────────────────────────────
# 렌더링 캐시·로그·부분 영상. 최종 mp4 는 02_강의안/media/ 에
# 복사되므로 이 폴더는 언제든 다시 만들 수 있습니다.
_build/
media/videos/
media/images/
media/texts/
media/Tex/

# ── 슬라이드 백업 ────────────────────────────────────
*.html.bak
*.rejected.css
*.new.css

# ── 파이썬 ───────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ── OS ───────────────────────────────────────────────
Thumbs.db
Desktop.ini
.DS_Store
